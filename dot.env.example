# ==========================================
# SevenSegmentMonitor Configuration Template
# ==========================================

# Core & Hardware
#CAMERA_PATH=/dev/video0
#VIDEO_GID=44
#DATA_PATH=./data
#DB_FILE=seventsegment_data.db
#LOGLEVEL=INFO
#FORCE_HEADLESS=False

# Database Maintenance & Retention
#CLEANUP_TIMEOUT=86400
#CLEANUP_PERIOD_DAYS=30

# Frame Capture & Simulation
#FRAME_FPS_DELAY=1.0
#LOAD_FRAME=False
#SAVE_FRAME=False
#FRAME_FILE_NAME=frame*.png

# Vision & Mask Processing
#VISION_MASK_TYPE=without_green
#ROTATE_FIXED_FRAME_ANGLE=
#ROTATE_FRAME_ANGLE=
#DIMMED_BRIGHTNESS=
#SMALL_COMPONENT_AREA=

# Color Mask Ranges
#WITHOUT_GREEN_RANGE=220,225
#RED_HSV_RANGE_1_LOW=0,40,180
#RED_HSV_RANGE_1_HIGH=18,255,255
#RED_HSV_RANGE_2_LOW=160,40,180
#RED_HSV_RANGE_2_HIGH=180,255,255
#RED_ADAPTIVE_RANGE=30,255

# Digit Segmentation & Recognition
#NUM_DIGITS_ROWS=2
#NUM_DIGITS_PER_ROW=3
#DIGIT_SHEAR_ANGLE=-7.0
#DIGIT_DENSITY_THRESH=0.15
#THRESHOLD_ON_STATE=3
#NORMALIZE_DIGITS_HEIGHT=False
#NORMALIZED_DIGITS_HEIGHT=64